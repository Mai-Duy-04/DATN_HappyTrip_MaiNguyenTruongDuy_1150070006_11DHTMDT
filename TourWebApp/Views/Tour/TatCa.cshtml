@model List<TourWebApp.Data.Models.Tour>
@using TourWebApp.Data.Models
@using TourWebApp.Helpers

@{
    ViewData["Title"] = "Khám phá tour | HappyTrip";

    var lichGanNhat = ViewBag.LichGanNhat
        as Dictionary<int, LichKhoiHanh>;

    var lichTheoNgay = ViewBag.LichTheoNgay
        as Dictionary<string, int>
        ?? new Dictionary<string, int>();

    var lichTheoTour = ViewBag.LichTheoTour
        as Dictionary<int, List<LichKhoiHanh>>
        ?? new Dictionary<int, List<LichKhoiHanh>>();

    var loaiTours = ViewBag.LoaiTours
        as List<LoaiTour> ?? new List<LoaiTour>();

    var phuongTienList = ViewBag.PhuongTienList
        as List<string> ?? new List<string>();

    var wishlistIds = ViewBag.WishlistIds
        as HashSet<int> ?? new HashSet<int>();

    var q = Context.Request.Query;
    var ngayDangChon = q["ngaydi"].ToString();

    var chiConCho =
        q["concho"] == "true" ||
        q["concho"] == "on";

    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;

    var selectedSort = q["sort"].ToString();
    var selectedLoai = q["idLoaiTour"].ToString();

    var selectedChuDe = q["chuDe"]
        .ToString()
        .Trim()
        .ToLowerInvariant();

    var returnUrl =
        $"{Context.Request.Path}{Context.Request.QueryString}";

    var chuDeNames = new Dictionary<string, string>
    {
        ["bien"] = "Biển đảo",
        ["nui"] = "Núi",
        ["vanhoa"] = "Văn hóa",
        ["thanhpho"] = "Thành phố",
        ["khampha"] = "Khám phá"
    };

    var tenChuDe = chuDeNames.TryGetValue(
        selectedChuDe,
        out var tenDaChon
    )
        ? tenDaChon
        : "Tất cả tour";
}

<link rel="stylesheet"
      href="~/css/tour-filter.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-compare.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-listing-premium.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/tour-compare-selection.css"
      asp-append-version="true" />

<style>

    /* DANH SACH LICH KHOI HANH TREN THE TOUR */
    .ht-tour-departures {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-width: 0;
        margin-top: 16px;
        padding-top: 13px;
        border-top: 1px solid #edf0ea;
    }

    .ht-tour-departures-label {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        color: #52675a;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .ht-tour-departures-label i {
        color: #cc914e;
        font-size: 15px;
    }

    .ht-tour-departures-scroll {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        overflow-x: auto;
        padding: 4px 2px 8px;
        scrollbar-width: thin;
        scrollbar-color: #c5d8c8 transparent;
    }

    .ht-tour-departure-date {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-width: 58px;
        padding: 7px 10px;
        border: 1px solid #d8a27b;
        border-radius: 7px;
        background: #fffaf5;
        color: #b66a35;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.2s ease,
                    border-color 0.2s ease,
                    color 0.2s ease;
    }

    .ht-tour-departure-date:hover {
        background: #28513c;
        border-color: #28513c;
        color: #ffffff;
        text-decoration: none;
    }

    .ht-tour-departure-date:focus-visible {
        outline: 2px solid #28513c;
        outline-offset: 2px;
    }

    .ht-tour-no-departure {
        color: #8b9690;
        font-size: 12px;
        font-style: italic;
    }

    @@media (max-width: 767px) {
        .ht-tour-departures {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .ht-tour-departures-scroll {
            width: 100%;
        }
    }

    /* HAPPYTRIP DEPARTURE CALENDAR */

    .ht-departure-filter {
        width: 100%;
    }

    .ht-departure-label {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        color: #244d38;
        font-size: 13px;
        font-weight: 800;
    }

    .ht-departure-label i {
        color: #c58b45;
    }

    .ht-calendar {
        width: 100%;
        padding: 12px 9px;
        background: #ffffff;
        border: 1px solid #e2e9df;
        border-radius: 15px;
    }

    .ht-calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        padding: 5px;
        background: #f3f7f1;
        border-radius: 30px;
    }

    .ht-calendar-month {
        color: #244d38;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .ht-calendar-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: #ffffff;
        color: #315a43;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .ht-calendar-nav:hover {
        background: #e2eee1;
    }

    .ht-calendar-weekdays,
    .ht-calendar-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 3px;
    }

    .ht-calendar-weekdays {
        margin-bottom: 7px;
    }

    .ht-calendar-weekdays span {
        padding: 7px 0;
        text-align: center;
        color: #879b8a;
        font-size: 11px;
        font-weight: 700;
    }

    .ht-calendar-day {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        width: 100%;
        min-height: 47px;
        padding: 5px 1px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 9px;
        color: #9aa99d;
        cursor: default;
    }

    .ht-calendar-day-number {
        font-size: 12px;
        font-weight: 600;
    }

    .ht-calendar-day-count {
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ht-calendar-day.has-tour {
        background: #ecf5eb;
        color: #275740;
        border-color: #deecdc;
        cursor: pointer;
    }

    .ht-calendar-day.has-tour:hover {
        background: #dbeedd;
        border-color: #a9cfaf;
    }

    .ht-calendar-day.is-selected {
        background: #24543d;
        border-color: #24543d;
        color: #ffffff;
    }

    .ht-calendar-day.is-selected:hover {
        background: #1b4230;
    }

    .ht-calendar-day.is-selected .ht-calendar-day-count {
        color: #ffe39b;
    }

    .ht-calendar-day.is-today {
        border-color: #d6a34b;
        box-shadow: inset 0 0 0 1px #d6a34b;
    }

    .ht-calendar-day.is-today .ht-calendar-day-number {
        color: #a96b19;
        font-weight: 900;
    }

    .ht-calendar-day.is-today.is-selected .ht-calendar-day-number {
        color: #ffffff;
    }

    .ht-calendar-day:focus-visible {
        outline: 2px solid #d39a45;
        outline-offset: 2px;
    }

    .ht-calendar-hint {
        margin: 13px 3px 0;
        color: #819587;
        font-size: 11px;
        line-height: 1.6;
    }

    .ht-calendar-hint i {
        margin-right: 4px;
    }

    @@media (max-width: 767px) {
        .ht-calendar-day {
            min-height: 45px;
        }
    }

    /* LIVE SEARCH */

    #happytripSearchResults {
        position: fixed;
        display: none;
        z-index: 2147483647;
        background: #ffffff;
        border: 1px solid #e0e8de;
        border-radius: 16px;
        box-shadow: 0 18px 48px rgba(25, 54, 35, .20);
        max-height: 380px;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 7px;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    .ht-search-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 88px;
        padding: 10px;
        text-decoration: none;
        border-radius: 10px;
        color: #254936;
        transition: background .15s ease;
    }

    .ht-search-result:hover,
    .ht-search-result:focus-visible {
        background: #edf5ec;
        color: #254936;
        text-decoration: none;
        outline: none;
    }

    .ht-search-result__icon {
        width: 88px;
        height: 66px;
        min-width: 88px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #edf4eb;
        color: #418458;
    }

    .ht-search-result__icon img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .25s ease;
    }

    .ht-search-result:hover .ht-search-result__icon img {
        transform: scale(1.06);
    }

    .ht-search-result__info {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        gap: 5px;
    }

    .ht-search-result__info strong {
        font-size: 13px;
        line-height: 1.45;
        font-weight: 700;
        white-space: normal;
    }

    .ht-search-result__info small {
        color: #7d8b80;
        font-size: 12px;
        line-height: 1.35;
    }

    .ht-search-result__price {
        flex-shrink: 0;
        color: #a77327;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .ht-search-message {
        padding: 16px 12px;
        color: #687a6e;
        font-size: 13px;
    }

    .ht-search-footer {
        padding: 10px 12px;
        border-top: 1px solid #eef1eb;
        color: #809084;
        font-size: 11px;
    }

    @@media (max-width: 600px) {
        .ht-search-result__icon {
            width: 70px;
            height: 57px;
            min-width: 70px;
        }

        .ht-search-result {
            flex-wrap: wrap;
            gap: 8px;
        }

        .ht-search-result__price {
            margin-left: 78px;
        }
    }
</style>

<div class="tours-container ht-explorer ht-travel-catalog">

    <!-- 01. HERO -->

    <section class="ht-catalog-hero"
             aria-labelledby="htCatalogTitle">

        <div class="ht-catalog-hero-overlay"></div>

        <div class="ht-catalog-hero-inner">

            <span class="ht-catalog-kicker">
                TOUR HAPPYTRIP
            </span>

            <h1 id="htCatalogTitle">
                Tìm chuyến đi dành cho bạn
            </h1>

            <p class="ht-catalog-description">
                Khám phá điểm đến và lựa chọn tour phù hợp
                với sở thích, thời gian và ngân sách.
            </p>

            <form asp-controller="Tour"
                  asp-action="TatCa"
                  method="get"
                  class="ht-catalog-search"
                  role="search">

                <i class="fa-solid fa-magnifying-glass"
                   aria-hidden="true"></i>

                <input type="search"
                       id="happytripHeroSearch"
                       name="diadiem"
                       value="@q["diadiem"]"
                       placeholder="Nhập tên tour hoặc điểm đến..."
                       aria-label="Tìm kiếm tour và điểm đến"
                       autocomplete="off" />

                @if (!string.IsNullOrWhiteSpace(selectedChuDe))
                {
                    <input type="hidden"
                           name="chuDe"
                           value="@selectedChuDe" />
                }

                <button type="submit">

                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>Tìm kiếm</span>

                </button>

            </form>

        </div>

    </section>

    <!-- 02. CHU DE -->

    <section class="ht-catalog-categories"
             aria-label="Khám phá theo chủ đề">

        <div class="ht-category-heading">

            <i class="fa-regular fa-compass"></i>
            <strong>Khám phá theo chủ đề:</strong>

        </div>

        <div class="ht-category-list">

            <a href="@BuildCategoryUrl("")"
               class="ht-category-pill @(string.IsNullOrEmpty(selectedChuDe) ? "is-active" : "")">

                <i class="fa-solid fa-border-all"></i>
                Tất cả

            </a>

            <a href="@BuildCategoryUrl("bien")"
               class="ht-category-pill @(selectedChuDe == "bien" ? "is-active" : "")">

                <i class="fa-solid fa-water"></i>
                Biển đảo

            </a>

            <a href="@BuildCategoryUrl("nui")"
               class="ht-category-pill @(selectedChuDe == "nui" ? "is-active" : "")">

                <i class="fa-solid fa-mountain"></i>
                Núi

            </a>

            <a href="@BuildCategoryUrl("vanhoa")"
               class="ht-category-pill @(selectedChuDe == "vanhoa" ? "is-active" : "")">

                <i class="fa-solid fa-landmark"></i>
                Văn hóa

            </a>

            <!-- THANH PHO: DA HOAT DONG -->

            <a href="@BuildCategoryUrl("thanhpho")"
               class="ht-category-pill @(selectedChuDe == "thanhpho" ? "is-active" : "")">

                <i class="fa-solid fa-city"></i>
                Thành phố

            </a>

            <a href="@BuildCategoryUrl("khampha")"
               class="ht-category-pill @(selectedChuDe == "khampha" ? "is-active" : "")">

                <i class="fa-regular fa-compass"></i>
                Khám phá

            </a>

        </div>

    </section>

    <!-- 03. MAIN LAYOUT -->
        <div class="ht-explorer-layout ht-catalog-layout">

        <!-- 04. SIDEBAR FILTER -->

        <aside class="ht-filter-sidebar ht-catalog-sidebar">

            <div class="ht-filter-heading">

                <div>
                    <i class="fa-solid fa-sliders"></i>
                    <strong>Bộ lọc tour</strong>
                </div>

                <a asp-controller="Tour"
                   asp-action="TatCa"
                   class="ht-filter-reset">

                    Xóa lọc

                </a>

            </div>

            <form method="get"
                  asp-controller="Tour"
                  asp-action="TatCa"
                  id="quickFilterForm"
                  class="ht-filter-form">

                @if (!string.IsNullOrWhiteSpace(selectedChuDe))
                {
                    <input type="hidden"
                           name="chuDe"
                           value="@selectedChuDe" />
                }

                <!-- Diem den -->

                <div class="ht-filter-group planner-field planner-field-relative">

                    <label for="diadiemInputTop">

                        <i class="fa-solid fa-location-dot"></i>
                        Điểm đến

                    </label>

                    <input type="text"
                           name="diadiem"
                           id="diadiemInputTop"
                           placeholder="Nhập tên tour hoặc điểm đến..."
                           value="@q["diadiem"]"
                           autocomplete="off" />

                    <div class="autocomplete-box"
                         id="goiYBoxTop"
                         style="display:none"></div>

                </div>

                <!-- Lich khoi hanh -->
                <div class="ht-filter-group ht-departure-filter">

                    <label class="ht-departure-label">
                        <i class="fa-regular fa-calendar-days"></i>
                        Ngày khởi hành
                    </label>

                    <input type="hidden"
                        id="ngaydiTop"
                        name="ngaydi"
                        value="@ngayDangChon" />

                    <div class="ht-calendar">

                        <div class="ht-calendar-header">

                            <button type="button"
                                    class="ht-calendar-nav"
                                    id="htCalendarPrev"
                                    aria-label="Tháng trước">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>

                            <span id="htCalendarMonth"
                                class="ht-calendar-month"></span>

                            <button type="button"
                                    class="ht-calendar-nav"
                                    id="htCalendarNext"
                                    aria-label="Tháng sau">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>

                        </div>

                        <div class="ht-calendar-weekdays">
                            <span>T2</span>
                            <span>T3</span>
                            <span>T4</span>
                            <span>T5</span>
                            <span>T6</span>
                            <span>T7</span>
                            <span>CN</span>
                        </div>

                        <div id="htCalendarDays"
                            class="ht-calendar-days"></div>

                        <p class="ht-calendar-hint">
                            <i class="fa-regular fa-circle-info"></i>
                            Chọn ngày để lọc tour. Nhấn lại ngày đã chọn để xem tất cả.
                        </p>

                    </div>

                </div>

                <!-- So ngay -->
                <div class="ht-filter-group planner-field">

                    <label for="songayTop">

                        <i class="fa-regular fa-clock"></i>
                        Số ngày

                    </label>

                    <input type="number"
                           id="songayTop"
                           name="songay"
                           min="1"
                           placeholder="Ví dụ: 3"
                           value="@q["songay"]" />

                </div>

                <!-- Loai tour -->

                <div class="ht-filter-group planner-field">

                    <label for="idLoaiTourTop">

                        <i class="fa-solid fa-layer-group"></i>
                        Loại tour

                    </label>

                    <select id="idLoaiTourTop"
                            name="idLoaiTour">

                        <option value="">
                            Tất cả loại tour
                        </option>

                        @foreach (var lt in loaiTours)
                        {
                            <option value="@lt.IdLoaiTour"
                                    selected="@(selectedLoai == lt.IdLoaiTour.ToString())">

                                @lt.TenLoai

                            </option>
                        }

                    </select>

                </div>

                <!-- Phuong tien -->

                <div class="ht-filter-group planner-field">

                    <label for="phuongTienTop">

                        <i class="fa-solid fa-bus-simple"></i>
                        Phương tiện

                    </label>

                    <select id="phuongTienTop"
                            name="phuongtien">

                        <option value="">
                            Tất cả phương tiện
                        </option>

                        @foreach (var pt in phuongTienList)
                        {
                            <option value="@pt"
                                    selected="@(q["phuongtien"] == pt)">

                                @pt

                            </option>
                        }

                    </select>

                </div>

                <!-- Con cho -->

                <div class="ht-filter-group ht-filter-check-group">

                    <label class="ht-filter-check"
                           for="conChoCheckTop">

                        <input type="checkbox"
                               id="conChoCheckTop"
                               name="concho"
                               value="true"
                               checked="@chiConCho" />

                        <span>
                            Chỉ hiển thị tour còn chỗ
                        </span>

                    </label>

                </div>

                <!-- Giu khoang gia -->

                @if (!string.IsNullOrWhiteSpace(q["giamin"]))
                {
                    <input type="hidden"
                           name="giamin"
                           value="@q["giamin"]" />
                }

                @if (!string.IsNullOrWhiteSpace(q["giamax"]))
                {
                    <input type="hidden"
                           name="giamax"
                           value="@q["giamax"]" />
                }

                @if (!string.IsNullOrWhiteSpace(selectedSort))
                {
                    <input type="hidden"
                           name="sort"
                           value="@selectedSort" />
                }

                <button type="submit"
                        class="ht-filter-submit">

                    <i class="fa-solid fa-filter"></i>
                    Lọc kết quả

                </button>

                <button type="button"
                        class="ht-filter-advanced"
                        data-bs-toggle="modal"
                        data-bs-target="#filterModal">

                    <i class="fa-solid fa-sliders"></i>
                    Lọc nâng cao

                </button>

            </form>

        </aside>

        <!-- 05. TOUR RESULTS -->

        <main class="ht-explorer-results ht-catalog-results">

            <div class="ht-results-toolbar">

                <div class="ht-results-title-wrap">

                    <h2>

                        @tenChuDe

                        <span class="ht-results-count">
                            @Model.Count
                        </span>

                    </h2>

                </div>

                <div class="ht-results-actions">

                    <span class="ht-results-page">
                        Trang @currentPage / @Math.Max(1, totalPages)
                    </span>

                    <form method="get"
                          asp-controller="Tour"
                          asp-action="TatCa"
                          class="ht-tour-sort-form"
                          id="tourSortForm">

                        @foreach (var parameter in Context.Request.Query)
                                                {
                            if (!string.Equals(
                                    parameter.Key,
                                    "sort",
                                    StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(
                                    parameter.Key,
                                    "page",
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <input type="hidden"
                                       name="@parameter.Key"
                                       value="@parameter.Value.ToString()" />
                            }
                        }

                        <label for="tourSortSelect">
                            Sắp xếp:
                        </label>

                        <select id="tourSortSelect"
                                name="sort">

                            <option value=""
                                    selected="@(selectedSort == "")">
                                Mặc định
                            </option>

                            <option value="ten"
                                    selected="@(selectedSort == "ten")">
                                Tên tour A–Z
                            </option>

                            <option value="gia_tang"
                                    selected="@(selectedSort == "gia_tang")">
                                Giá thấp đến cao
                            </option>

                            <option value="gia_giam"
                                    selected="@(selectedSort == "gia_giam")">
                                Giá cao đến thấp
                            </option>

                        </select>

                        <button type="submit"
                                class="ht-sort-submit">

                            Áp dụng

                        </button>

                    </form>

                </div>

            </div>

            <!-- KHONG CO KET QUA -->

            @if (Model.Count == 0)
            {
                <div class="ht-results-empty">

                    <i class="fa-regular fa-compass"></i>

                    <h3>
                        Chưa tìm thấy tour phù hợp
                    </h3>

                    @if (selectedChuDe == "thanhpho")
                    {
                        <p>
                            Hiện chưa có tour được gắn
                            chủ đề Thành phố.
                            Bạn có thể khám phá những
                            chủ đề khác của HappyTrip.
                        </p>
                    }
                    else
                    {
                        <p>
                            Bạn thử thay đổi điểm đến,
                            ngày đi hoặc các điều kiện
                            lọc nhé.
                        </p>
                    }

                    <a asp-controller="Tour"
                       asp-action="TatCa">

                        Xem tất cả tour

                    </a>

                </div>
            }
            else
            {
                <!-- TOUR CARDS -->

                <section class="tours-showcase ht-ticket-list">

                    <div class="tour-listing-grid ht-ticket-grid">

                        @{
                            var tourIndex = 0;
                        }

                        @foreach (var t in Model)
                        {
                            var lich = lichGanNhat != null &&
                                lichGanNhat.TryGetValue(
                                    t.IdTour,
                                    out var lichTimDuoc
                                )
                                ? lichTimDuoc
                                : null;

                            var soCho = lich?.SoChoConLai ?? 0;

                            var trangThai = lich == null
                                ? "Chưa có lịch"
                                : soCho <= 0
                                    ? "Hết chỗ"
                                    : soCho <= 5
                                        ? "Sắp hết chỗ"
                                        : "Còn chỗ";

                            var statusClass = lich == null
                                ? "ht-status-pending"
                                : soCho <= 0
                                    ? "ht-status-full"
                                    : soCho <= 5
                                        ? "ht-status-low"
                                        : "ht-status-open";

                            var tenLoai = loaiTours
                                .FirstOrDefault(x =>
                                    x.IdLoaiTour == t.IdLoaiTour)
                                ?.TenLoai ?? "Tour du lịch";

                            var giaHienThi =
                                t.GiaKhuyenMai ?? t.GiaGoc;

                            var diaDiemTour = t.DiaDiem?.Trim() ?? "";
                            var dauPhanCach = new[] { "→", "–", " - " }
                                .Select(d => diaDiemTour.IndexOf(d, StringComparison.Ordinal))
                                .Where(i => i >= 0)
                                .DefaultIfEmpty(diaDiemTour.Length)
                                .Min();
                            var diemKhoiHanh = diaDiemTour.Length == 0
                                ? "Chưa cập nhật"
                                : diaDiemTour.Substring(0, dauPhanCach).Trim();

                            var danhSachLich = lichTheoTour.TryGetValue(
                                t.IdTour,
                                out var lichCuaTour
                            )
                                ? lichCuaTour
                                : new List<LichKhoiHanh>();

                            var lichConCho = danhSachLich
                                .Where(l =>
                                    l.SoChoConLai > 0 &&
                                    (
                                        l.TrangThai == "Còn chỗ" ||
                                        l.TrangThai == "Sắp hết chỗ"
                                    )
                                )
                                .OrderBy(l => l.NgayKhoiHanh)
                                .ThenBy(l => l.GioKhoiHanh)
                                .ToList();

