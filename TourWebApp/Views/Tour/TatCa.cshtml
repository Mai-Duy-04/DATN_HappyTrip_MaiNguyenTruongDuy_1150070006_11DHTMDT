                                            </span>

                                        </div>

                                        <div class="ht-tour-info">

                                            <i class="fa-solid fa-bus-simple"></i>

                                            <span>

                                                Phương tiện: @(string.IsNullOrWhiteSpace(t.PhuongTien)
                                                    ? "Chưa cập nhật"
                                                    : t.PhuongTien)

                                            </span>
                                                                                    </div>

                                    </div>

                                    <!-- DANH SACH NGAY KHOI HANH -->
                                        <div class="ht-tour-departures">

                                            <div class="ht-tour-departures-label">
                                                <i class="fa-regular fa-calendar-days"></i>
                                                <span>Ngày khởi hành:</span>
                                            </div>

                                            @if (lichConCho.Any())
                                            {
                                                <div class="ht-tour-departures-scroll">

                                                    @foreach (var lichItem in lichConCho)
                                                    {
                                                        var ngayHienThi =
                                                            lichItem.NgayKhoiHanh.ToString("dd/MM");

                                                        var ngayDayDu =
                                                            lichItem.NgayKhoiHanh.ToString("dd/MM/yyyy");

                                                        <a asp-controller="Tour"
                                                        asp-action="ChiTiet"
                                                        asp-route-id="@t.IdTour"
                                                        class="ht-tour-departure-date"
                                                        title="Khởi hành ngày @ngayDayDu">

                                                            @ngayHienThi

                                                        </a>
                                                    }

                                                </div>
                                            }
                                            else
                                            {
                                                <span class="ht-tour-no-departure">
                                                    Chưa có lịch khởi hành còn chỗ
                                                </span>
                                            }

                                    </div>

                                </div>

                                <!-- GIA VA HANH DONG -->

                                <div class="ht-ticket-booking">

                                    <span class="ht-tour-status @statusClass">

                                        @trangThai

                                    </span>

                                    <div class="ht-ticket-price">

                                        <span>
                                            Giá từ / khách
                                        </span>

                                        <strong>

                                            @(giaHienThi.HasValue
                                                ? string.Format(
                                                    "{0:N0}đ",
                                                    giaHienThi.Value)
                                                : "Liên hệ")

                                        </strong>

                                    </div>

                                    <div class="ht-ticket-actions">

                                        <a asp-controller="Tour"
                                           asp-action="ChiTiet"
                                           asp-route-id="@t.IdTour"
                                           class="tour-link-detail ht-tour-detail">

                                            Khám phá tour

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </a>

                                        <button type="button"
