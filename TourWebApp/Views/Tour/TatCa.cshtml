                                                Điểm khởi hành: @diemKhoiHanh
                                            </span>

                                        </div>

                                        <div class="ht-tour-info">

                                            <i class="fa-regular fa-clock"></i>

                                            <span>

                                                Thời gian: @(string.IsNullOrWhiteSpace(t.ThoiGian)
                                                    ? "Theo lịch tour"
