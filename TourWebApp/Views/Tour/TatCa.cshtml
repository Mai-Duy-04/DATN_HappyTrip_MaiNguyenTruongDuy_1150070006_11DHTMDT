                                            @t.MaTour
                                        </span>

                                    </div>

                                    <h3 class="tour-list-title ht-tour-title"
                                        title="@t.TenTour">

                                        @t.TenTour

                                    </h3>

                                    <div class="ht-tour-information
                                                ht-ticket-information">

                                        <div class="ht-tour-info ht-tour-info-code">
                                            <i class="fa-solid fa-ticket"></i>
                                            <span>Mã chương trình: @t.MaTour</span>
                                        </div>

                                        <div class="ht-tour-info">

                                            <i class="fa-solid fa-location-dot"></i>

